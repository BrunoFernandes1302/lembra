# Copie para .env e ajuste:  cp .env.example .env

# --- Supabase (banco + login) ---
# URL e chave "publishable" são públicas por design (vão até no app do celular).
# A segurança vem do login + Row Level Security, não de esconder essas duas.
# NUNCA coloque aqui a chave service_role/secret: ela ignora o RLS.
SUPABASE_URL=https://xxikbkdtyswcpsaqtmjg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Cz5KoK2lFsX3Li89GnZz-A_1QFPziyS

# --- LLM (quem gera a resposta) ---
#   gemini    -> Google, tem nível GRATUITO (chave em aistudio.google.com). Atenção: no gratuito
#                o Google pode usar os trechos enviados para melhorar produtos.
#   anthropic -> Claude, pago por uso (platform.claude.com)
#   ollama    -> modelo local, grátis e privado (precisa do Ollama rodando)
#   nenhum    -> sem IA generativa: só mostra as memórias encontradas
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (quanto o modelo "pensa" antes de responder)
ANTHROPIC_EFFORT=medium

OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# --- Embeddings (texto -> vetor) ---
#   gemini -> gemini-embedding-001 (usa a GEMINI_API_KEY; o texto das memórias passa pelo Google)
#   local  -> intfloat/multilingual-e5-small no próprio servidor (EMBEDDING_DIM=384; ~1 GB de RAM;
#             exige mudar o banco para vector(384) e reprocessar as memórias)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# --- WhatsApp (bot oficial, Cloud API da Meta) — opcional; sem isto o webhook responde 503 ---
# developers.facebook.com → seu app → WhatsApp → Configuração da API
WHATSAPP_TOKEN=            # token de acesso (para enviar mensagens e baixar áudios)
WHATSAPP_PHONE_ID=         # "Phone number ID" do número do Lembra
WHATSAPP_NUMERO=           # o número do Lembra só com dígitos (ex.: 15551234567), mostrado no app
WHATSAPP_APP_SECRET=       # Configurações do app → Básico → Chave secreta (confere a assinatura)
WHATSAPP_VERIFY_TOKEN=     # texto aleatório que você inventa e repete ao cadastrar o webhook
# Supabase → Project Settings → JWT Keys → Legacy JWT secret. Permite ao servidor emitir crachás
# de 5 min para o dono do número (o RLS continua valendo). É um segredo-mestre: só no servidor.
SUPABASE_JWT_SECRET=

# --- Ping diário do banco (cron da Vercel → GET /saude/banco) — opcional ---
# Se definido, o endpoint exige "Authorization: Bearer <este valor>" (a Vercel envia sozinha nas chamadas
# do cron quando a variável existe no projeto). Gere um texto aleatório longo. Sem ele, o endpoint é aberto.
CRON_SECRET=
