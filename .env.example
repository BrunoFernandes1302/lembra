# Copie para .env e ajuste:  cp .env.example .env

# --- Supabase (banco + login) ---
# URL e chave "publishable" são públicas por design (vão até no app do celular).
# A segurança vem do login + Row Level Security, não de esconder essas duas.
# NUNCA coloque aqui a chave service_role/secret: ela ignora o RLS.
SUPABASE_URL=https://xxikbkdtyswcpsaqtmjg.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_Cz5KoK2lFsX3Li89GnZz-A_1QFPziyS

# --- LLM (quem gera a resposta) ---
# "anthropic" (Claude, via API) ou "ollama" (modelo local, Fase 3)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (quanto o modelo "pensa" antes de responder)
ANTHROPIC_EFFORT=medium

OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# --- Embeddings (roda localmente, sem custo) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
